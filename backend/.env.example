NODE_ENV=development
PORT=4000

# Neon serverless Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/yugenbd?sslmode=require

# JWT access + refresh token secrets (use long random strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (image storage — no local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed origins (comma-separated): storefront + admin app
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# The two fixed admin accounts seeded by the admin seeder.
ADMIN1_NAME=Faysal
ADMIN1_EMAIL=faysal.ahamed.tarek1@gmail.com
ADMIN1_PASSWORD=Rz6#mVbK9tXpL2q
ADMIN2_NAME=Tanvir
ADMIN2_EMAIL=tanvirjp123@gmail.com
ADMIN2_PASSWORD=Wf4!hTdQ8yNsC3r

# Storefront base URL used in emails (password-reset links)
FRONTEND_URL=http://localhost:3000

# SMTP for transactional email (password reset). For Gmail, create an App
# Password (Google Account -> Security -> 2-Step Verification -> App passwords)
# and use it as SMTP_PASS. If SMTP_USER/SMTP_PASS are unset, reset links are
# logged to the server console instead of emailed (dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gmail ignores custom from-addresses that don't match the authenticated
# account — keep SMTP_FROM the same mailbox as SMTP_USER (display name is ok).
SMTP_FROM="YugenBD <your-gmail@gmail.com>"

# Inbox notified on every customer order (defaults to yugenbd@gmail.com).
ORDER_NOTIFICATION_EMAIL=yugenbd@gmail.com
