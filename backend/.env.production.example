# ── backend/.env  (copy this file to backend/.env on the server) ─────────────
# Loaded by dotenv at runtime. NEVER commit the filled-in .env.

NODE_ENV=production
PORT=4000

# Neon serverless Postgres (same DB you already use — it's cloud-hosted, so you
# do NOT install Postgres on the VPS). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/yugenbd?sslmode=require

# JWT secrets — generate NEW long random strings for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (image/video storage — already cloud-hosted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed browser origins that may call the API (comma-separated, NO trailing
# slash). Must list the storefront and the admin subdomain exactly.
CORS_ORIGIN=https://yugenbd.com,https://www.yugenbd.com,https://hTdQ8yNsC3r.yugenbd.com

# Seeder-only admin accounts. Needed ONLY for the first `npm run seed`.
# After seeding, DELETE these four lines from the server .env (they are not
# read at runtime) and change the passwords from the app's Change Password page.
ADMIN1_NAME=Faysal
ADMIN1_EMAIL=faysal.ahamed.tarek1@gmail.com
ADMIN1_PASSWORD=change-me-strong
ADMIN2_NAME=Tanvir
ADMIN2_EMAIL=tanvirjp123@gmail.com
ADMIN2_PASSWORD=change-me-strong
