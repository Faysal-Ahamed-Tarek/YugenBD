# ── frontend/.env.production  (copy to frontend/.env.production on the server) ─
# IMPORTANT: every NEXT_PUBLIC_* value is BAKED IN AT BUILD TIME. If you change
# any of these you MUST rebuild (npm run build) — a restart alone won't apply it.

# API base used by SERVER components (server-side fetch, runtime). Public URL is
# fine; you may also use the internal http://127.0.0.1:4000/api/v1 for speed.
API_URL=https://api.yugenbd.com/api/v1

# API base used by the BROWSER (checkout POST, review submit, sidebar refetch).
# Must be the public HTTPS API domain.
NEXT_PUBLIC_API_URL=https://api.yugenbd.com/api/v1

# Canonical site URL (metadata, OpenGraph, JSON-LD, sitemap).
NEXT_PUBLIC_SITE_URL=https://yugenbd.com

# bKash merchant/personal number shown on checkout for manual "Send Money".
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
