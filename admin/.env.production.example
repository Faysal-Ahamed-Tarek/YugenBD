# ── admin/.env.production  (copy to admin/.env.production on the server) ──────
# NEXT_PUBLIC_* is baked in at BUILD TIME — rebuild after any change.

# Server-side fetch base (runtime).
API_URL=https://api.yugenbd.com/api/v1

# Browser API base — the admin dashboard talks to the API from the browser
# (login, CRUD, uploads). Must be the public HTTPS API domain.
NEXT_PUBLIC_API_URL=https://api.yugenbd.com/api/v1
